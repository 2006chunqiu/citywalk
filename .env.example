# 复制本文件为 .env 后填写真实值，.env 不要提交
# 每个人本地用自己的高德 Key，服务端用主 Key

# 后端使用：高德 Web 服务 Key，多个用逗号分隔，按“当日用量最少优先”选用
AMAP_WEB_KEYS=

# 前端使用：高德 JS API Key 与安全密钥（需在控制台配置域名白名单）
VITE_AMAP_JS_KEY=
VITE_AMAP_JS_SECRET=

# 前端请求后端的地址；本地 mock 时指向 mock 端口
VITE_API_BASE=http://localhost:8000

# 是否使用本地假数据（上线前必须为 false）
VITE_MOCK=true

# 数据库
DATABASE_URL=postgresql://citywalk:password@localhost:5432/citywalk

# 模型服务（不填则自动降级为模板文案）
LLM_API_KEY=
